#!/bin/sh
set -eu
PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PROJECT_PYTHON="${COLLECTHUB_PYTHON:-$PROJECT_DIR/.venv/bin/python}"
if [ ! -x "$PROJECT_PYTHON" ]; then
  PROJECT_PYTHON=python3
fi
PYTHONPATH="$PROJECT_DIR/src${PYTHONPATH:+:$PYTHONPATH}" exec "$PROJECT_PYTHON" -m content_ingestor.cli "$@"
