# Optional Notion sync. Never commit real values.
CONTENT_OS_NOTION_TOKEN=ntn_replace_me
CONTENT_OS_NOTION_DATA_SOURCE_ID=replace_with_your_data_source_id
# Optional local library override.
# COLLECTHUB_LIBRARY=~/CollectHub
# Optional runtime location overrides.
# CONTENT_OS_XHS_HOME=~/.local/share/collecthub/runtimes/xhs-downloader/2.7
# COLLECTHUB_MEDIA_RUNTIME_HOME=~/.local/share/collecthub/runtimes/media/gallery-dl-1.32.1_yt-dlp-2026.07.04_deno-2.8.1
# Backward-compatible alias: CONTENT_OS_X_RUNTIME_HOME
# Optional private Netscape Cookie file overrides (mode 0600).
# COLLECTHUB_YOUTUBE_COOKIE_FILE=~/.config/collecthub/cookies/youtube.txt
# COLLECTHUB_TIKTOK_COOKIE_FILE=~/.config/collecthub/cookies/tiktok.txt
# COLLECTHUB_FACEBOOK_COOKIE_FILE=~/.config/collecthub/cookies/facebook.txt
# COLLECTHUB_ZHIHU_COOKIE_FILE=~/.config/collecthub/cookies/zhihu.txt
