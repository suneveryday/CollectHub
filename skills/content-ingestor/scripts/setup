#!/bin/sh
set -eu

VERSION=1.2.1
INSTALLER="https://raw.githubusercontent.com/suneveryday/CollectHub/v$VERSION/install.sh"

echo "This installs CollectHub v$VERSION and pinned third-party runtimes in your user account."
echo "Review: https://github.com/suneveryday/CollectHub/tree/v$VERSION"
curl --proto '=https' --tlsv1.2 -fsSL "$INSTALLER" | sh -s -- "$@"
